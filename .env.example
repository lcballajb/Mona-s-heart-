# Server-only AI settings. All high-risk features remain disabled without all three values.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
# Never prefix secrets with VITE_; VITE_ values are exposed to the browser.
RXNORM_PROXY_ENABLED=false
# Server-only terminology controls. RxNorm does not require a browser credential.
RXNORM_TIMEOUT_MS=3000
RXNORM_CACHE_TTL_MS=900000
RXNORM_NEGATIVE_CACHE_TTL_MS=60000
SNOMED_PROVIDER_ENABLED=false
SNOMED_SERVER_URL=https://licensed-provider.example.invalid
SNOMED_SERVER_TOKEN=REPLACE_WITH_SECRET_MANAGER_REFERENCE
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://app_user:REPLACE_ME@localhost:5432/monas_heart
DATABASE_ADAPTER=memory
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
SESSION_PEPPER=REPLACE_WITH_SECRET_MANAGER_REFERENCE
CSRF_SECRET=REPLACE_WITH_SECRET_MANAGER_REFERENCE
OBJECT_STORAGE_BUCKET=monas-heart-development-private
OBJECT_STORAGE_KMS_KEY_ID=REPLACE_WITH_KMS_KEY_REFERENCE
MALWARE_SCANNER_ENDPOINT=https://scanner.example.invalid
ERROR_MONITORING_DSN=REPLACE_WITH_SERVER_SIDE_DSN
LOG_HASH_KEY=REPLACE_WITH_SECRET_MANAGER_REFERENCE
